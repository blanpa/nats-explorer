{
  "name": "nats-explorer",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "cd go-server && PORT=3002 go run .",
    "dev:client": "pnpm --filter client dev",
    "build": "pnpm --filter shared build && pnpm --filter client build && scripts/build-server.sh current",
    "docker:build": "docker build -f go-server/Dockerfile -t nats-explorer .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "nats:start": "pnpm --filter nats-dev start",
    "nats:stop": "pnpm --filter nats-dev stop",
    "nats:seed": "pnpm --filter nats-dev seed",
    "nats:simulate": "pnpm --filter nats-dev simulate",
    "nats:dev": "pnpm --filter nats-dev dev",
    "test": "pnpm --filter client test && cd go-server && go test ./...",
    "test:e2e": "pnpm --filter e2e test",
    "build:server": "scripts/build-server.sh",
    "build:desktop": "scripts/build-desktop.sh"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0"
  },
  "packageManager": "pnpm@10.34.5"
}
