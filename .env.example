# NATS Explorer server settings (copy to .env or export before starting the binary)
PORT=3002
# PUBLIC_PATH=./public        # UI files; found automatically next to the binary or in client/dist

# --- Access -----------------------------------------------------------------
# AUTH_TOKEN=change-me        # one shared token for the API and the websocket
# AUTH_USERS=/etc/nats-explorer/users.txt    # name:role:bcrypt-hash per line; turns on the login and roles

# --- History ----------------------------------------------------------------
# HISTORY_MB=256              # in-memory history budget per process
# HISTORY_DB=/data/history.db # keep a copy on disk, so time ranges and search work
# HISTORY_RETENTION=72h       # how long the persisted messages are kept
# ROLLUP_RETENTION=2160h      # how long the minute aggregates behind long charts are kept

# --- Storage ----------------------------------------------------------------
# STORAGE_DIR=/var/lib/nats-explorer   # keep connections and templates on the server (single-user)
# NO_KEYRING=1                # with STORAGE_DIR: use secrets.json instead of the system keyring

# --- Source (AGPL) ----------------------------------------------------------
# SOURCE_URL=https://git.example.org/ops/nats-explorer
#                             # where the source of THIS build is offered. Only
#                             # needed if you changed the code and let others use
#                             # it; unset it points at the upstream project at the
#                             # commit the binary was built from.

# --- Diagnostics ------------------------------------------------------------
# PPROF=1                     # serve Go's profiler under /debug/pprof
