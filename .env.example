# NATS Explorer server settings (copy to .env or export before starting the binary)
PORT=3002
# PUBLIC_PATH=./public        # UI files; found automatically next to the binary or in client/dist
# AUTH_TOKEN=change-me        # require this token for the API and websocket
# STORAGE_DIR=/var/lib/nats-explorer   # keep connections and templates on the server (single-user)
# NO_KEYRING=1                # with STORAGE_DIR: use secrets.json instead of the system keyring
