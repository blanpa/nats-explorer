<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata: what software centres (GNOME Software, KDE Discover,
     Flathub) show about the app. The release list is extended by every
     release commit; scripts/check-packaging.sh (CI) fails when the newest
     changelog version is missing here. -->
<component type="desktop-application">
  <id>io.github.blanpa.nats-explorer</id>
  <name>NATS Explorer</name>
  <summary>Browse and manage NATS servers, JetStream and Key-Value stores</summary>
  <developer id="io.github.blanpa">
    <name>blanpa</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <description>
    <p>
      NATS Explorer shows what goes on in a NATS system. Subjects appear as a
      live tree with the history, a value chart and the decoded payload of each
      one, and the messages stay available after the window is closed.
    </p>
    <ul>
      <li>JetStream streams and consumers: create, edit, purge, browse messages and follow delivery</li>
      <li>Key-Value buckets with revisions and Object Stores with uploads and downloads</li>
      <li>Requests that can be saved, repeated and measured, with latency percentiles</li>
      <li>Micro services, server and cluster monitoring, leaf nodes and gateways</li>
      <li>Alerts for subjects that go quiet or carry unexpected values</li>
      <li>Payloads decoded as JSON, MessagePack, Protobuf or Avro</li>
    </ul>
    <p>
      Connections support user and password, tokens, NKeys, credential files,
      mutual TLS and SSH bastions. Passwords are kept in the system keyring.
    </p>
    <p>
      NATS is a trademark of the Linux Foundation. This application is not
      affiliated with or endorsed by the NATS project.
    </p>
  </description>

  <launchable type="desktop-id">io.github.blanpa.nats-explorer.desktop</launchable>
  <provides>
    <binary>nats-explorer</binary>
  </provides>

  <url type="homepage">https://blanpa.github.io/nats-explorer/</url>
